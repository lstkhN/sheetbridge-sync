# Production defaults for docker compose
ADAPTER_MODE=demo
QUEUE_BACKEND=postgres
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://sheetbridge:change-me@db:5432/sheetbridge
REQUIRE_ADMIN_AUTH=true
SYNC_ADMIN_TOKEN=replace-with-a-long-random-secret
WORKER_LEASE_SECONDS=60
WORKER_POLL_SECONDS=1

# Set ADAPTER_MODE=live and provide both integrations:
# GOOGLE_API_KEY=replace-me
# BITRIX_WEBHOOK_URL=https://company.bitrix24.ru/rest/1/secret/
# BITRIX_ALLOWED_HOST=company.bitrix24.ru
